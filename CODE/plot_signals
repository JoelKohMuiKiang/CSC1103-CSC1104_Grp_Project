set terminal png size 1400,700
set output "signals.png"
set title "Stage A: SMA crossover signals"
set xlabel "Trade number"
set ylabel "Price (USDT)"
set grid

set key right bottom font ",9" spacing 1.6 samplen 3

plot "signals.dat" using 1:2 with lines lc rgb "gray"  title "Price", \
     "" using 1:3 with lines lc rgb "red"   title "Short SMA", \
     "" using 1:4 with lines lc rgb "blue"  title "Long SMA", \
     "" using ($5==1  ? $1 : 1/0):3 with points pt 9  ps 2 lc rgb "green" title "BUY", \
     "" using ($5==-1 ? $1 : 1/0):3 with points pt 11 ps 2 lc rgb "red"   title "SELL"